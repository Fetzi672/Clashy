# Clash of Clans API token (https://developer.clashofclans.com/) - must allow your server's IP
COC_API_TOKEN=your_coc_api_token_here
# Discord bot token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# The one Discord server the bot works in (guild ID)
ALLOWED_GUILD_ID=000000000000000000
# Your clan tag including #
CLAN_TAG=#YOUR_CLAN_TAG
# Your Discord user ID: full access to the admin commands
OWNER_DISCORD_ID=000000000000000000
